# Broke No More backend environment
# Local development: copy to backend/.env and replace placeholders.
# Production: configure these in the hosting platform; never commit real values.

NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/brokenomore

# Generate at least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-at-least-32-random-characters

# Origins only: no trailing slash or path. Production values must use HTTPS.
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google OAuth credentials
# Local authorized redirect URI:
# http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Web Push (optional). Without these the reminder job never schedules and the
# notification toggle stays hidden; everything else works unchanged.
# Generate once with: npx web-push generate-vapid-keys --json
# Changing them later permanently breaks every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Local hours (0-23) for the evening "nothing logged" reminder and the morning
# budget notification.
DAILY_REMINDER_HOUR=21
MORNING_BUDGET_HOUR=8
# Leave empty to run notifications on a timer inside the server (always-on hosts).
# On Cloud Run, set 32+ random characters (`openssl rand -hex 32`) and have Cloud
# Scheduler POST /api/jobs/notifications hourly with header X-Cron-Secret.
CRON_SECRET=

# Frontend deployment variable (configure in Vercel, not backend/.env):
# VITE_API_URL=https://your-api.example.com